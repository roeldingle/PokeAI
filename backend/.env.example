# backend/.env.example - Environment Configuration for PokeAI Arena

# Environment mode: local | develop | production
APP_ENV=local

# Game Metadata and Identity
VERSION="0.1.0"
PROJECT_GOAL="AI Engineering Path while building a turn-based monster battler game."
GAME_TITLE="PokeAI"
GAME_DESCRIPTION="A turn-based monster battler (PokeMon like) engineered step-by-step to master AI Engineering principles."
GAME_GUIDE="Athena"

# API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL="http://localhost:11434"

# Models
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_MODEL=qwen2.5:3b

# Allowed Origins for Cross-Origin Resource Sharing (CORS)
# Enables the Vite React frontend on port 5173 to speak with our FastAPI backend on port 8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
