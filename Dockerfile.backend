# =============================================================================
# Dockerfile.backend — Production FastAPI + ChromaDB + Resilient LLM Container
# Lesson 11: Production Evals, Guardrails, Docker & CI/CD Pipeline
# =============================================================================

# Use the official lightweight Python 3.12 slim image for minimal attack surface
FROM python:3.12-slim

# Prevent Python from writing .pyc bytecode files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Set container working directory
WORKDIR /app

# Install system build dependencies needed by native packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies first to maximize Docker layer caching
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Copy backend source code and tests into the container
COPY backend/ /app/

# Expose the FastAPI Uvicorn port
EXPOSE 8000

# Configure container healthcheck against the root stadium health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Launch Uvicorn ASGI server in production mode
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
