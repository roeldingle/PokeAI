# =============================================================================
# Dockerfile.frontend — Multi-Stage React 19 + TypeScript + Vite Build Container
# Lesson 11: Production Evals, Guardrails, Docker & CI/CD Pipeline
# =============================================================================

# Stage 1: Build the production React/Vite bundle using Node 20 Alpine
FROM node:20-alpine AS frontend-builder

# Set build directory inside the builder container
WORKDIR /app

# Copy package manifests first to leverage Docker layer caching
COPY frontend/package*.json ./

# Install deterministic frontend dependencies
RUN npm ci

# Copy all frontend TypeScript, CSS, and asset files
COPY frontend/ ./

# Compile TypeScript and bundle static production assets into /app/dist
RUN npm run build

# Stage 2: Serve static assets with lightweight Nginx Alpine
FROM nginx:stable-alpine AS frontend-production

# Copy compiled Vite assets from Stage 1 into Nginx's public web root
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Expose port 5173 (or standard HTTP port 80)
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
